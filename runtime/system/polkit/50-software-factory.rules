// What the warden may ask systemd and logind for, and nothing more: start and stop the four template units that run
// one request each (a request or a check as the agent, a stack verb as the stack user, a deploy of prod as the box's
// admin), restart the agents' Claude daemon (so it loads the token of the account the owner switched to), set the
// factory slice's budget, start an upgrade to a commit (the one unit it starts as root, whose runner downloads that
// commit from GitHub itself), and hold the sleep and lid locks while agents work. No unit of any other name.
polkit.addRule(function (action, subject) {
  if (subject.user !== "@warden_user@") {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id === "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    if (/^software-(agent|stack|check|deploy)-run@[A-Za-z0-9_-]+\.service$/.test(unit) && (verb === "start" || verb === "stop")) {
      return polkit.Result.YES;
    }
    if (/^software-upgrade@[0-9a-f]{40}\.service$/.test(unit) && verb === "start") {
      return polkit.Result.YES;
    }
    if (unit === "@daemon_unit@" && verb === "restart") {
      return polkit.Result.YES;
    }
    if (unit === "@slice@" && verb === "set-property") {
      return polkit.Result.YES;
    }
    return polkit.Result.NO;
  }
  if (action.id === "org.freedesktop.login1.inhibit-block-sleep" ||
      action.id === "org.freedesktop.login1.inhibit-block-idle" ||
      action.id === "org.freedesktop.login1.inhibit-handle-lid-switch") {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
