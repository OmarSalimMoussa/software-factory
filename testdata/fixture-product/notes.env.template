# The notes app's settings. The factory writes notes.env from this file for each workspace and laptop slot: it fills
# the keys factory.toml's [env.set] names and adds the shared services' keys; the others keep the values below.
NOTES_WORKSPACE=
NOTES_ORIGIN=
NOTES_PORT=
NOTES_IMAGE_TAG=
NOTES_STORE=/data/notes.json
NOTES_SYNC_URL=https://sync.example.com/notes
