# Lets bubblewrap create the user namespace each check runs in. Ubuntu blocks unprivileged user namespaces by
# default (kernel.apparmor_restrict_unprivileged_userns), which would stop every check from starting.
abi <abi/4.0>,
include <tunables/global>

profile software-bwrap @bwrap@ flags=(unconfined) {
  userns,

  include if exists <local/software-bwrap>
}
