# An upgrade of the factory to commit %i, as root; the commit before is the way back. The warden may start this unit
# and nothing more; the runner downloads the commit from GitHub with root's own token and runs its install, which
# stops the warden and the dashboard and starts them again on the new factory. Outside the factory's slice: the
# install stops what runs there.
[Unit]
Description=software factory: upgrade to %i
CollectMode=inactive-or-failed

[Service]
Type=oneshot
User=root
Environment=PATH=@path@
ExecStart=@python@ -I @install@/runtime/system/runners/upgrade.py %i
# However the run ended (a timeout's kill too), an upgrade still marked running is marked stopped.
ExecStopPost=@python@ -I @install@/runtime/system/runners/upgrade.py --ended %i
TimeoutStartSec=@upgrade_minutes@
UMask=0022
