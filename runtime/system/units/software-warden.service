# The warden: the one service that starts sessions, and only through the two template units polkit allows it.
[Unit]
Description=software factory: the warden
Wants=network-online.target
After=network-online.target

[Service]
# Ready once public/ holds the settings the dashboard reads at its start: the dashboard is ordered after it.
Type=notify
NotifyAccess=main
User=@warden_user@
Group=@warden_user@
# The slots' group lets new slot env files take it, so the stack user's runs can read them. The agent's group: git
# asks access(2) whether the agents' checkout is a repository before it pushes from it, and access(2) ignores the
# capability below for anyone but root. The agent's files are its group's to read already.
SupplementaryGroups=@slots_group@ @agent_user@
ExecStart=@python@ -I @install@/runtime/system/runners/start.py runtime.warden.wardend
ExecStopPost=@python@ -I @install@/runtime/system/pause_checks.py stop
Restart=always
RestartSec=@restart_seconds@
# Reads every transcript and checkout to price calls and check heads; read and search only, never write.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
# The state folder itself is 0700, so only public/ (bound into the other units) is ever read by anyone else.
UMask=0022
RuntimeDirectory=@run_name@
RuntimeDirectoryMode=0755
ProtectSystem=strict
# The agent's home too, for the queue folder in its checkout: the only folder there the warden owns, so the only
# one its writes can reach.
ReadWritePaths=@state@ @agent_home@
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
KillMode=control-group

[Install]
WantedBy=multi-user.target
