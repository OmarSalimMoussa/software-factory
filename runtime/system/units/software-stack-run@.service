# One `scripts/dev` verb the warden wrote to public/launch/<id>.json, run as the stack user with its rootless Docker.
# Product code runs here, never as root: a container's root is this user on the host.
[Unit]
Description=software factory: stack request %i
CollectMode=inactive-or-failed
Wants=@slot_keys_unit@
After=@slot_keys_unit@

[Service]
Type=oneshot
User=@stack_user@
Group=@stack_user@
# The slots' group reads their env files; the agent's group reads the checkout the verb builds.
SupplementaryGroups=@slots_group@ @agent_user@
Slice=@slice@
Environment=XDG_RUNTIME_DIR=/run/user/@stack_uid@
Environment=DOCKER_HOST=unix://@stack_socket@
Environment=PATH=@path@
Environment=@uv_env@
ExecStart=@python@ -I @install@/runtime/system/runners/stack_run.py @state@ %i
# append, not truncate: systemd opens the file again for the exit recorder, and truncating would empty it.
StandardOutput=append:@runs@/%i.log
# What the verb reads, such as the export the reports verb sorts, which no agent may read on its way.
StandardInput=file:@runs@/%i.in
StandardError=inherit
ExecStopPost=+@python@ -I @install@/runtime/system/runners/record_exit.py @runs@/%i.exit
UMask=0027
TemporaryFileSystem=@state@:ro
# The exit recorder runs in this unit's mount namespace too, + or not: runs/ is bound back for it. It stays the
# warden's and 0700, so this unit's own user can neither read nor write it.
BindPaths=@runs@
BindReadOnlyPaths=@public@ @slots@
ProtectHome=tmpfs
BindPaths=@stack_home@
# ProtectHome=tmpfs also hides /run/user: the user's runtime folder (its sockets) is bound back in.
BindPaths=/run/user/@stack_uid@
BindReadOnlyPaths=@agent_home@
InaccessiblePaths=-/run/docker.sock
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
