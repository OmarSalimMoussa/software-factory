#!/usr/bin/env python3
"""The notes app's stack, with the factory's fixed verbs.

The notes app has no containers, so the stack verbs say what a real stack would do. `test` runs the real tests.
The factory sets FACTORY_SLOT, FACTORY_PORT and FACTORY_SLOT_DIR before a stack verb.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VERBS = ("up", "down", "empty", "health", "sign-in", "seed", "desktop", "verbs", "test", "reports")


def _slot() -> str:
    return os.environ["FACTORY_SLOT"]


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in VERBS:
        print(f"usage: scripts/dev {{{'|'.join(VERBS)}}} ...", file=sys.stderr)
        return 2
    verb, args = argv[0], argv[1:]
    if verb == "verbs":
        print("\n".join(VERBS))
    elif verb == "test":
        return subprocess.run([sys.executable, "-m", "pytest", *args], cwd=ROOT, check=False).returncode
    elif verb in ("up", "down", "empty"):
        print(f"{verb}: slot {_slot()} has no containers; services: {' '.join(args) or 'all'}")
    elif verb == "health":
        print(f"http://127.0.0.1:{os.environ['FACTORY_PORT']}/health")
    elif verb == "sign-in":
        if len(args) != 1:
            print("usage: scripts/dev sign-in <email>", file=sys.stderr)
            return 2
        print(f"http://127.0.0.1:{os.environ['FACTORY_PORT']}/sign-in?as={args[0]}")
    elif verb == "seed":
        if args[:1] == ["check"]:
            print("seed check: no seed is saved")
        else:
            print(f"seed {' '.join(args)}: slot {_slot()} has no data to save or load")
    elif verb == "desktop":
        print("desktop: not supported", file=sys.stderr)
        return 1
    # reports: the notes app collects no user reports, so it prints none.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
