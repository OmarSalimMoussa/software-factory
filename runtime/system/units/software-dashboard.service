# The owner's dashboard, its own process so it still serves the page and the last known state while the warden is down.
[Unit]
Description=software factory: the owner's dashboard
Wants=network-online.target
After=network-online.target @warden_unit@

[Service]
Type=simple
User=@dashboard_user@
Group=@dashboard_user@
ExecStart=@python@ -I @install@/runtime/system/runners/start.py runtime.dashboard.server
Restart=always
RestartSec=@restart_seconds@
# Of the warden's state it sees public/ alone, read-only; everything else it asks the warden for.
TemporaryFileSystem=@state@:ro
BindReadOnlyPaths=@public@
NoNewPrivileges=yes
CapabilityBoundingSet=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
