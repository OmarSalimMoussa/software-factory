{
  "skipDangerousModePermissionPrompt": true,
  "env": {"MCP_TIMEOUT": "@mcp_start_ms@"},
  "hooks": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "@guard@", "timeout": @hook_timeout@}]}
    ],
    "PostToolUse": [
      {"matcher": "TaskStop", "hooks": [{"type": "command", "command": "@guard@", "timeout": @hook_timeout@}]}
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "@guard@", "timeout": @hook_timeout@},
          {"type": "command", "command": "@loader@", "timeout": @hook_timeout@}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {"type": "command", "command": "@guard@", "timeout": @hook_timeout@},
          {"type": "command", "command": "@loader@", "timeout": @hook_timeout@}
        ]
      }
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "@guard@", "timeout": @hook_timeout@}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "@guard@", "timeout": @hook_timeout@}]}
    ]
  }
}
